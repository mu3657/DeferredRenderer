#version 450
#extension GL_GOOGLE_include_directive : require
#define ENVIRONMENT_SET 1
#include "environment_map.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, set = 0, binding = 0) uniform image2D targetImage;
layout(set = 1, binding = 2) uniform sampler2D environmentPanorama;
layout(push_constant) uniform SkyPushConstants {
    mat4 inverseViewProjection;
} sky;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(targetImage);
    if (any(greaterThanEqual(pixel, extent))) return;

    vec2 ndc = (vec2(pixel) + 0.5) / vec2(extent) * 2.0 - 1.0;
    vec4 nearPoint = sky.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    vec4 farPoint = sky.inverseViewProjection * vec4(ndc, 0.0, 1.0);
    vec3 direction = normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
    imageStore(targetImage, pixel,
        vec4(sampleEnvironmentPanorama(environmentPanorama, direction)
            * environmentIntensity(), 1.0));
}
